TELEGRAM_BOT_TOKEN=123456789:AA-توکن-ربات-شما
TELEGRAM_CHAT_ID=@your_channel
INSTAGRAM_USERNAME=your_ig_page
# INSTAGRAM_COOKIES_FILE=cookies.txt
