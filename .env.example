# ============================================================
# تنظیمات شکارچی خبر عطر (Perfume News Scout)
# ============================================================
# توکن و چت همان ربات بالا (مثلاً @atr_ads_bot)
# برای پیدا کردن chat_id عددی خودت:  python scout.py --whoami
# SCOUT_DIGEST_HOUR=9        # ساعت ارسال دایجست به وقت تهران
# SCOUT_DIGEST_MINUTE=30     # دقیقه ارسال
# SCOUT_MIN_SCORE=25         # حداقل امتیاز برای انتخاب سوژه
#
# اختیاری: فعال‌سازی هوش مصنوعی برای نگارش بهتر بریف‌ها
# (هر سرویس سازگار با OpenAI کار می‌کند)
# SCOUT_LLM_API_KEY=sk-...
# SCOUT_LLM_BASE_URL=https://api.openai.com/v1
# SCOUT_LLM_MODEL=gpt-4o-mini
